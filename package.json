{
  "name": "bidbox",
  "version": "1.0.0",
  "description": "BidBox - On-Chain Auction dApp on Botchain Mainnet",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network hardhat",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network botchainMainnet",
    "verify:mainnet": "hardhat verify --network botchainMainnet",
    "dev": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  },
  "keywords": [
    "auction",
    "web3",
    "botchain",
    "solidity",
    "hardhat",
    "wagmi",
    "viem"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^18.0.8",
    "hardhat": "^2.29.1"
  }
}
