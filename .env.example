# ==========================================
# BidBox Environment Variables
# ==========================================

# Botchain Testnet RPC
BOTCHAIN_RPC_URL="https://rpc.bohr.life"

# Private key of the deployer / creator wallet (DO NOT prefix with 0x)
# DO NOT commit real private keys to version control!
PRIVATE_KEY=""

# Optional Auction Deployment Parameters
AUCTION_ITEM_NAME="Genesis Botchain Pass #001"
# Auction duration in seconds (e.g. 259200 = 3 days, 86400 = 1 day, 3600 = 1 hour)
AUCTION_DURATION_SECONDS="259200"
